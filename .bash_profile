# Bash login shells load this file after agent-shell has started Bash.
# Keep the base image's login startup behavior, then restore the runtime
# environment so startup files cannot hide the installed agent CLIs.
if [[ -r "${HOME}/.profile" ]]; then
    # shellcheck disable=SC1090
    source "${HOME}/.profile"
elif [[ "${-}" == *i* && -r "${HOME}/.bashrc" ]]; then
    # shellcheck disable=SC1090
    source "${HOME}/.bashrc"
fi

if [[ -r /run/agent-environment ]]; then
    # This file is generated by docker-entrypoint using Bash-safe quoting.
    # shellcheck disable=SC1091
    source /run/agent-environment
fi
